# Copy to .env (uncommitted) and paste keys. Inspect and the harness read this file.
# Spend split: ~90% Grok (workers, orchestrator, mid monitor), ~10% OpenAI (Luna monitor only).
# No keys are required for ENV-3 generators, fixtures, or the deterministic A2A hello-world.

OPENAI_API_KEY=
XAI_API_KEY=

# Optional alias accepted by Inspect for Grok:
# GROK_API_KEY=
